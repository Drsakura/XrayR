# Shell scripts and systemd units must keep LF endings, otherwise they break
# on Linux with "bad interpreter: No such file or directory" when the repo is
# checked out on Windows (core.autocrlf=true).
*.sh text eol=lf
*.service text eol=lf

# Config samples shipped to Linux servers.
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Go sources.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

Dockerfile text eol=lf
